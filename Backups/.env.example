# ---------------------------------------------------------------------------
# McNews configuration. Copy this file to ".env" and fill in your own values.
#   copy .env.example .env      (PowerShell)
# ---------------------------------------------------------------------------

# --- Telegram (REQUIRED, read-only access) ----------------------------------
# Create an app once at https://my.telegram.org -> "API development tools".
# api_id is a number, api_hash is a 32 character string.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: your phone in international format. Leave empty and Telethon will
# ask for it during "python main.py login".
TELEGRAM_PHONE=

# Optional: where the login session is stored (default: <project>/sessions/mcnews).
TELEGRAM_SESSION=

# Optional default channels, comma separated. Any of these formats work:
#   @channelname
#   https://t.me/channelname
#   https://t.me/s/channelname
#   https://t.me/c/1234567890/42      (private channel the account already joined)
#   -1001234567890                    (numeric id)
# TELEGRAM_CHANNELS=@channelname,@otherchannel

# --- Local AI model ---------------------------------------------------------
# provider: "ollama" (native /api/chat) or "openai" (any OpenAI-compatible
# local server such as LM Studio, llama.cpp server or vLLM).
LLM_PROVIDER=ollama

# Defaults: ollama -> http://127.0.0.1:11434
#           openai -> http://127.0.0.1:1234/v1
LLM_BASE_URL=

# Model to use. Examples: qwen2.5:3b (small + fast), qwen3:4b, llama3.1:8b.
LLM_MODEL=qwen2.5:3b

# Only needed for OpenAI-compatible servers that require a key (any dummy value
# usually works for LM Studio / llama.cpp).
LLM_API_KEY=

# Generation settings.
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=240
LLM_NUM_CTX=8192
LLM_MAX_TOKENS=1024

# --- Pipeline ---------------------------------------------------------------
# Characters taken from a single Telegram post before it is cut.
MAX_MESSAGE_CHARS=1500
# Characters per model call (posts are split into batches of this size).
BATCH_CHARS=6000
# Seconds Telethon may sleep silently when Telegram asks us to slow down.
FLOOD_SLEEP=60
# Where raw posts / reports / state are written (default: <project>/data).
DATA_DIR=
